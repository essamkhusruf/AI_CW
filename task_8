import heapq
import time
import collections
from typing import List, Tuple, Dict, Callable, Optional

# Define the goal state for the 8-puzzle (0 represents the blank space)
# Goal: 1 2 3 / 4 5 6 / 7 8 0
GOAL_STATE = (1, 2, 3, 4, 5, 6, 7, 8, 0)
GOAL_INDEX_MAP = {tile: i for i, tile in enumerate(GOAL_STATE)}
GRID_SIZE = 3 # 3x3 grid

# --- Heuristics ---

def misplaced_tiles(state: Tuple[int, ...]) -> int:
    """
    Heuristic 1: Counts the number of tiles not in their goal position.
    The blank tile (0) is ignored.
    """
    count = 0
    for i in range(9):
        if state[i] != 0 and state[i] != GOAL_STATE[i]:
            count += 1
    return count

def manhattan_distance(state: Tuple[int, ...]) -> int:
    """
    Heuristic 2: Calculates the sum of the Manhattan distances for every tile
    from its current position to its goal position.
    """
    distance = 0
    for i in range(9):
        tile = state[i]
        if tile == 0:
            continue

        current_row, current_col = divmod(i, GRID_SIZE)
        goal_index = GOAL_INDEX_MAP[tile]
        goal_row, goal_col = divmod(goal_index, GRID_SIZE)

        distance += abs(current_row - goal_row) + abs(current_col - goal_col)
    return distance

def linear_conflict(state: Tuple[int, ...]) -> int:
    """
    Heuristic 3: Manhattan Distance + Linear Conflict.
    A linear conflict occurs when two tiles are in their goal row/column
    but are reversed relative to each other, requiring at least two extra moves.
    This heuristic is admissible and more informative than standard Manhattan distance.
    """
    h_manhattan = manhattan_distance(state)
    conflict_count = 0

    # Check for conflicts in rows
    for r in range(GRID_SIZE):
        row_start = r * GRID_SIZE
        row_end = row_start + GRID_SIZE
        row = state[row_start:row_end]

        # Check all pairs of tiles (i, j) in the row
        for i in range(GRID_SIZE):
            for j in range(i + 1, GRID_SIZE):
                tile_i = row[i]
                tile_j = row[j]

                # Check if both tiles belong to this row in the goal state
                if (tile_i != 0 and tile_j != 0 and
                    divmod(GOAL_INDEX_MAP[tile_i], GRID_SIZE)[0] == r and
                    divmod(GOAL_INDEX_MAP[tile_j], GRID_SIZE)[0] == r):

                    # Conflict: tile_i should come after tile_j, but is currently before it
                    if GOAL_INDEX_MAP[tile_i] > GOAL_INDEX_MAP[tile_j]:
                        conflict_count += 1

    # Check for conflicts in columns (similar logic)
    for c in range(GRID_SIZE):
        col = [state[r * GRID_SIZE + c] for r in range(GRID_SIZE)]

        for i in range(GRID_SIZE):
            for j in range(i + 1, GRID_SIZE):
                tile_i = col[i]
                tile_j = col[j]

                # Check if both tiles belong to this column in the goal state
                if (tile_i != 0 and tile_j != 0 and
                    divmod(GOAL_INDEX_MAP[tile_i], GRID_SIZE)[1] == c and
                    divmod(GOAL_INDEX_MAP[tile_j], GRID_SIZE)[1] == c):

                    # Conflict: tile_i should come after tile_j, but is currently before it
                    if GOAL_INDEX_MAP[tile_i] > GOAL_INDEX_MAP[tile_j]:
                        conflict_count += 1

    # Linear conflict adds 2 to the heuristic cost for every conflict found
    return h_manhattan + 2 * conflict_count

# --- A* Search Implementation ---

class AStarSolver:
    """
    Implements the A* search algorithm for the 8-puzzle.
    """
    def __init__(self, heuristic: Callable[[Tuple[int, ...]], int]):
        self.heuristic = heuristic
        self.goal = GOAL_STATE

    def get_inversions(self, state: Tuple[int, ...]) -> int:
        """Calculates the number of inversions in the state (excluding 0)."""
        inversions = 0
        arr = [i for i in state if i != 0]
        n = len(arr)
        for i in range(n):
            for j in range(i + 1, n):
                if arr[i] > arr[j]:
                    inversions += 1
        return inversions

    def is_solvable(self, state: Tuple[int, ...]) -> bool:
        """
        Determines if the 8-puzzle state is solvable.
        A 3x3 puzzle is solvable if the number of inversions is even.
        """
        inversions = self.get_inversions(state)
        return inversions % 2 == 0

    def get_neighbors(self, state: Tuple[int, ...]) -> List[Tuple[int, ...]]:
        """Generates all valid neighboring states by moving the blank space (0)."""
        neighbors = []
        zero_index = state.index(0)
        z_row, z_col = divmod(zero_index, GRID_SIZE)

        # Possible moves: (dr, dc)
        for dr, dc in [(0, 1), (0, -1), (1, 0), (-1, 0)]:
            n_row, n_col = z_row + dr, z_col + dc

            if 0 <= n_row < GRID_SIZE and 0 <= n_col < GRID_SIZE:
                neighbor_index = n_row * GRID_SIZE + n_col

                # Create the new state by swapping 0 and the neighbor tile
                new_state_list = list(state)
                new_state_list[zero_index], new_state_list[neighbor_index] = \
                    new_state_list[neighbor_index], new_state_list[zero_index]

                neighbors.append(tuple(new_state_list))

        return neighbors

    def solve(self, start_state: Tuple[int, ...]) -> Optional[Dict]:
        """Runs the A* search algorithm."""

        if not self.is_solvable(start_state):
            return None # Unsolvable configuration

        start_time = time.time()

        # Priority Queue stores: (f_cost, g_cost, state)
        # f_cost is used for priority
        start_h = self.heuristic(start_state)
        priority_queue = [(start_h, 0, start_state)]

        # g_cost_map stores g(n): cost from start to n
        g_cost_map = {start_state: 0}

        # Stores the parent state for path reconstruction
        parent_map: Dict[Tuple[int, ...], Optional[Tuple[int, ...]]] = {start_state: None}

        explored_nodes = 0

        while priority_queue:
            f_cost, g_cost, current_state = heapq.heappop(priority_queue)
            explored_nodes += 1

            if current_state == self.goal:
                end_time = time.time()

                # Path reconstruction and return
                path_length = g_cost

                # Path reconstruction (optional, but good for verification)
                path = []
                curr = current_state
                while curr is not None:
                    path.append(curr)
                    curr = parent_map.get(curr)
                path.reverse()

                return {
                    'solved': True,
                    'time_taken': end_time - start_time,
                    'nodes_expanded': explored_nodes,
                    'path_length': path_length,
                    'final_f_cost': f_cost
                }

            # Generate neighbors
            for neighbor_state in self.get_neighbors(current_state):
                new_g_cost = g_cost + 1

                # Check if this new path to the neighbor is better
                if new_g_cost < g_cost_map.get(neighbor_state, float('inf')):
                    g_cost_map[neighbor_state] = new_g_cost
                    parent_map[neighbor_state] = current_state

                    h_cost = self.heuristic(neighbor_state)
                    f_cost = new_g_cost + h_cost

                    # Push to priority queue
                    heapq.heappush(priority_queue, (f_cost, new_g_cost, neighbor_state))

        end_time = time.time()
        return {'solved': False, 'time_taken': end_time - start_time, 'nodes_expanded': explored_nodes}

# --- 5. Test States ---

TEST_STATES = {
    # Solvable: Requires few moves (Easy)
    "Trivial Solvable (1)": (1, 2, 3, 4, 5, 6, 7, 0, 8), # Path length 1

    # Solvable: Medium difficulty
    "Medium Solvable (2)": (1, 2, 3, 4, 0, 6, 7, 5, 8), # Path length ~4-8

    # Solvable: Hard difficulty
    "Hard Solvable (3)": (8, 6, 7, 2, 5, 4, 3, 0, 1),   # Path length ~25-30

    # Solvable: Very Hard difficulty (Max possible path length is 31)
    "Very Hard Solvable (4)": (6, 4, 7, 8, 5, 0, 3, 2, 1), # Path length ~28-31

    # Unsolvable: Inversions count is odd
    "Unsolvable (5)": (8, 1, 2, 0, 4, 3, 7, 6, 5) # Goal cannot be reached
}

HEURISTICS = {
    "Misplaced Tiles (h1)": (misplaced_tiles, "Weak Admissible"),
    "Manhattan Distance (h2)": (manhattan_distance, "Stronger Admissible"),
    "Linear Conflict (h3)": (linear_conflict, "Consistent and Powerful")
}

# --- 6. Execution and Analysis ---

def format_time(seconds):
    """Formats time nicely, using ms for small values."""
    if seconds < 0.001:
        return f"{seconds * 1000:.3f} ms"
    return f"{seconds:.4f} s"

def run_tests():
    """Runs all tests and gathers performance data."""
    results = collections.defaultdict(dict)

    for heuristic_name, (heuristic_func, _) in HEURISTICS.items():
        solver = AStarSolver(heuristic_func)

        for state_name, start_state in TEST_STATES.items():
            print(f"Running {heuristic_name} on {state_name}...")

            result = solver.solve(start_state)

            if result is None:
                # Unsolvable state detected early
                results[state_name][heuristic_name] = {'solved': False, 'status': 'UNSOLVABLE (Correctly Detected)'}
            elif result['solved']:
                results[state_name][heuristic_name] = {
                    'status': f"Solved (Depth: {result['path_length']})",
                    'time': format_time(result['time_taken']),
                    'nodes': result['nodes_expanded']
                }
            else:
                # Should not happen for solvable puzzles if the search is complete
                results[state_name][heuristic_name] = {'status': 'FAILED'}

    return results

def print_results(results):
    """Prints the final comparison table."""

    print("\n" + "=" * 100)
    print("ANALYSIS: 8-PUZZLE HEURISTIC PERFORMANCE COMPARISON")
    print("=" * 100)

    header = ["Test State", "Solvability", "Heuristic", "Nodes Expanded", "Time Taken (s)", "Path Length"]
    row_format = "{:<25} {:<15} {:<25} {:<18} {:<15} {:<15}"
    print(row_format.format(*header))
    print("-" * 100)

    # Helper function to get the actual path length for solvable states
    def get_path_length(state):
        # We assume the shortest path is constant regardless of optimal heuristic used
        # Run H2 once to get the optimal path length for solvable states
        solver = AStarSolver(manhattan_distance)
        result = solver.solve(state)
        return result['path_length'] if result and result['solved'] else "N/A"

    for state_name, state_results in results.items():
        is_solvable = "Solvable" if "Unsolvable" not in state_name else "Unsolvable"

        # Get the true path length for solvable puzzles for comparison
        path_len = get_path_length(TEST_STATES[state_name]) if is_solvable == "Solvable" else "N/A"

        first = True
        for heuristic_name, data in state_results.items():

            row_data = [
                state_name if first else "",
                is_solvable if first else "",
                heuristic_name,
            ]

            if data['status'].startswith("Solved"):
                row_data.extend([
                    data['nodes'],
                    data['time'],
                    path_len
                ])
            else:
                row_data.extend([
                    "N/A",
                    "N/A",
                    "N/A"
                ])

            print(row_format.format(*row_data))
            first = False
        print("-" * 100)

def main():
    print("Initializing 8-Puzzle A* Solver with three heuristics...")

    # 1. Run all tests
    performance_results = run_tests()

    # 2. Print results and analysis
    print_results(performance_results)

    print("\n\n--- Analysis Conclusion ---")
    print("H1 (Misplaced Tiles) is the weakest, expanding the most nodes and taking the longest time.")
    print("H2 (Manhattan Distance) provides a significant improvement, reducing nodes expanded drastically.")
    print("H3 (Linear Conflict) is the most powerful, often showing the lowest node expansion count and fastest time, especially for harder puzzles, by being more accurate (consistent) than H2.")
    print("For the unsolvable case, the A* solver correctly returns 'UNSOLVABLE' after checking the inversion count, regardless of the heuristic used.")

if __name__ == "__main__":
    main()
